{
  "name": "react-permission-control",
  "version": "1.0.1",
  "description": "🛡️ The lightweight, type-safe authorization library for React. Declarative <Can /> components, hooks, and RBAC/ABAC access control with zero dependencies.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\" \"README.md\"",
    "clean": "rimraf dist coverage",
    "prepublishOnly": "npm run clean && npm run typecheck && npm run lint && npm test && npm run build"
  },
  "keywords": [
    "react",
    "permission",
    "permissions",
    "authorization",
    "access-control",
    "rbac",
    "abac",
    "can",
    "roles",
    "role-based-access-control",
    "typescript",
    "security"
  ],
  "author": "Antigravity Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lvlinh45/react-permission.git"
  },
  "bugs": {
    "url": "https://github.com/lvlinh45/react-permission/issues"
  },
  "homepage": "https://github.com/lvlinh45/react-permission#readme",
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.13.9",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@typescript-eslint/eslint-plugin": "^8.26.0",
    "@typescript-eslint/parser": "^8.26.0",
    "eslint": "^9.21.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.5.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rimraf": "^6.0.1",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  }
}
